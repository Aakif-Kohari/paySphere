# E2E Test Environment Variables
# Copy this file to .env.test and fill in your test account credentials.
# .env.test is git-ignored and should NEVER be committed.

# URL of the running frontend dev server (default shown)
BASE_URL=http://localhost:5173

# Credentials for a pre-existing test account in your local/staging database.
# These are used by auth.spec.js and employee-creation.spec.js
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=YourTestPassword123!
