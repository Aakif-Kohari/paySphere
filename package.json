{
  "name": "paysphere-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.1",
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx}": [
      "prettier --write",
      "npm run lint --prefix frontend"
    ],
    "backend/**/*.js": [
      "prettier --write",
      "npm run lint --prefix backend"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}
