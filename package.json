{
  "name": "paysphere-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prepare": "husky || true",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "pnpm --filter frontend test -- run --passWithNoTests"
    ],
    "backend/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write",
      "pnpm --filter backend test -- --findRelatedTests --passWithNoTests"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "latest"
  }
}
